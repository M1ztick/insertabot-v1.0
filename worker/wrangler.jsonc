// insertabot-api — Cloudflare Workers Configuration
// Migrated from wrangler.toml to wrangler.jsonc
// Last updated: 2026-02-23
{
  "name": "insertabot-api",
  "main": "src/index.ts",
  "compatibility_date": "2025-11-17",
  "compatibility_flags": ["nodejs_compat"],

  // Static assets (public directory)
  "assets": {
    "directory": "./public"
  },

  // Smart placement — lets Cloudflare run the Worker closer to your backend
  // services (D1, etc.) rather than always closest to the user
  "placement": {
    "mode": "smart"
  },

  // Observability — 10% sampling in production to manage costs
  // while still capturing meaningful signal
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  },

  // Disable workers.dev subdomain and preview URLs — production uses custom domains only
  "workers_dev": false,
  "preview_urls": false,

  // Routes — source of truth; do not configure these via the Dashboard
  // to avoid config drift on future deploys
  "routes": [
    {
      "pattern": "insertabot.io",
      "zone_name": "insertabot.io",
      "custom_domain": true
    },
    {
      "pattern": "insertabot.io/api/*",
      "zone_name": "insertabot.io"
    },
    {
      "pattern": "insertabot.io/*",
      "zone_name": "insertabot.io"
    }
  ],

  // D1 — production relational database
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "insertabot-production",
      "database_id": "3d7d004d-ed6c-486c-a51e-a59f51bcd307"
    }
  ],

  // KV — rate limiting store
  "kv_namespaces": [
    {
      "binding": "RATE_LIMITER",
      "id": "5f08c9439c594be69c44c69a8c7aa280"
    }
  ],

  // Vectorize — embeddings index for RAG
  "vectorize": [
    {
      "binding": "VECTORIZE",
      "index_name": "insertabot-embeddings"
    }
  ],

  // Analytics Engine — explicit dataset name prevents dashboard drift
  "analytics_engine_datasets": [
    {
      "binding": "ANALYTICS",
      "dataset": "ANALYTICS"
    }
  ],

  // Workers AI binding
  "ai": {
    "binding": "AI"
  },

  // Cron triggers — run scheduled() handler periodically
  // "0 3 * * *" = every day at 03:00 UTC
  "triggers": {
    "crons": ["0 3 * * *"]
  },
  
  // Environment variables
  // NOTE: Do NOT add secrets here. Manage secrets via:
  //   wrangler secret put STRIPE_SECRET_KEY
  //   wrangler secret put STRIPE_WEBHOOK_SECRET
  //   wrangler secret put STRIPE_PRO_PRICE_ID
  //   wrangler secret put TAVILY_API_KEY
  // STRIPE_PUBLISHABLE_KEY is a publishable (non-secret) key but is omitted
  // here intentionally to keep it out of version control. Set it via:
  //   wrangler secret put STRIPE_PUBLISHABLE_KEY
  // (Secrets are fine for publishable keys and keeps the config clean)
  "vars": {
    "ENVIRONMENT": "production",
    "CORS_ORIGINS": "https://insertabot.io"
  }
}