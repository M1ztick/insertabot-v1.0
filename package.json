{
  "name": "insertabot",
  "version": "1.0.0",
  "description": "Insertabot - AI-powered chatbot widget for websites",
  "scripts": {
    "dev": "node scripts/dev-server.js",
    "dev:port": "node scripts/dev-server.js --port",
    "dev:worker": "wrangler dev --config worker/wrangler.jsonc --env=\"\"",
    "deploy": "wrangler deploy --config worker/wrangler.jsonc --env=\"\"",
    "deploy:production": "wrangler deploy --config worker/wrangler.jsonc --env=\"\"",
    "deploy:dev": "echo '⚠️  Development deployments are archived. Use npm run deploy for production only.' && exit 1",
    "test": "node scripts/dev-server.js --port 8080",
    "prepare": "husky install || true",
    "lint:secrets": "secretlint --config .secretlintrc.json \"**/*\" --max-warnings 0",
    "scan:secrets": "npm run lint:secrets"
  },
  "keywords": [
    "chatbot",
    "ai",
    "widget",
    "cloudflare-workers",
    "customer-support"
  ],
  "author": "Mistyk Media",
  "license": "GNU-v2",
  "dependencies": {
    "zod": "^3.22.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260103.0",
    "@secretlint/secretlint-rule-preset-recommend": "^11.2.5",
    "husky": "^8.0.0",
    "secretlint": "^11.2.5",
    "wrangler": "^4.67.0"
  }
}